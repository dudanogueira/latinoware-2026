            "uid": "${datasource}"
          },
          "expr": "sum by (operation) (rate(vector_index_maintenance_durations_ms_sum{job=~\"$job\", namespace=~\"$namespace\", instance=~\"$node\", class_name=~\"$collection\", shard_name=~\"$shard\"}[$__rate_interval])) / sum by (operation) (rate(vector_index_maintenance_durations_ms_count{job=~\"$job\", namespace=~\"$namespace\", instance=~\"$node\", class_name=~\"$collection\", shard_name=~\"$shard\"}[$__rate_interval]))",
          "legendFormat": "mean {{operation}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Maintenance latency (mean)",

          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, op, api) (rate(weaviate_module_request_duration_seconds_bucket{job=~\"$job\", namespace=~\"$namespace\", instance=~\"$node\"}[$__rate_interval])))",
          "legendFormat": "p95 {{op}} {{api}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request latency p95",
      "type": "timeseries"
    },

          "expr": "sum by (class_name) (vector_index_tombstones{job=~\"$job\", namespace=~\"$namespace\", instance=~\"$node\", class_name=~\"$collection\", shard_name=~\"$shard\"})",
          "legendFormat": "{{class_name}}",
          "range": true,
          "refId": "A"
